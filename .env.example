# Public site URL (use the Vercel preview URL while testing)
NEXT_PUBLIC_SITE_URL=https://virgopodcast.com

# Legacy payment settlement only — the public Google booking page needs no secrets.
# Neon Postgres
DATABASE_URL=

# Historical Stripe webhook credentials (no new checkout sessions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Legacy webhook calendar integration, separate from the current Google appointment page
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Isolated Stripe sandbox integration. Set ONLY for local development or a protected
# Vercel Preview on codex/stripe-test-checkout. Never enable for Production.
TEST_CHECKOUT_ENABLED=false
# Local origin only. On Vercel Preview, omit this and VERCEL_URL is used automatically.
TEST_CHECKOUT_ORIGIN=http://localhost:3000
STRIPE_TEST_SECRET_KEY=
# Signing secret for /api/stripe/test-webhook, NOT the legacy webhook.
STRIPE_TEST_WEBHOOK_SECRET=
# A separate empty Neon database/branch; apply db/test-bookings.sql there.
TEST_DATABASE_URL=
# A separate test calendar for sandbox reservations (must NOT be a live calendar).
GOOGLE_TEST_CALENDAR_ID=
# Actual calendar IDs checked by the Google appointment schedule; comma-separated.
# Read-only free/busy queries. Do not include the test calendar or the alias "primary".
GOOGLE_AVAILABILITY_CALENDAR_IDS=
GOOGLE_TEST_CLIENT_EMAIL=
GOOGLE_TEST_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
